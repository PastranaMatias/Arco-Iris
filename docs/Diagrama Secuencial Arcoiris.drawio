        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ninterface IMostrable {\n    + mostrar(): void\n}\n\nclass Usuario implements IMostrable {\n    - nombre: String\n    - dni: String\n    - id: String\n    + mostrar(): void\n}\n\nclass Producto implements IMostrable {\n    - nombre: String\n    - codigoProducto: Int\n    - material: String\n    - color: String\n    - precio: Float\n    - cantidad: Int\n    + mostrar(): void\n    + calcularPrecio(): Float\n}\n\nclass Descuento {\n    - tipo: String\n    - porcentaje: Float\n    + aplicar(precio: Float): Float\n}\n\nclass Pedido {\n    - idPedido: Int\n    - fecha: Date\n    - estado: String\n    - productosSolicitados: List&lt;Producto&gt;\n    + generarPedido(listaProductos: List&lt;Producto&gt;): void\n    + actualizarEstado(nuevoEstado: String): void\n}\n\nclass Stock {\n    - cantidadDisponible: Int\n    - alerta: Boolean\n    + verificar(): Boolean\n}\n\nclass GestorProductos {\n    - listaProductos: List&lt;Producto&gt;\n    + agregarProducto(p: Producto): void\n    + aplicarDescuento(p: Producto, d: Descuento): Float\n    + verificarStock(p: Producto): Boolean\n    + mostrarPreciosFinales(): void\n}\n\nUsuario \&quot;0..*\&quot; --&gt; \&quot;1\&quot; GestorProductos\nGestorProductos \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto\nGestorProductos \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pedido\nProducto \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Stock\nProducto \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Descuento\nPedido \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fYZwpuDFZZy8Yt072TMK-1">
